# --- Network ---
# Which Hedera network everything (402 network id, USDC token selection,
# treasury 2% forward, HCS audit feed) runs on. STRICT: must be one of
# mainnet | testnet | previewnet; any other value crashes the server at
# startup rather than silently using the wrong network. Default: testnet.
HEDERA_NETWORK=testnet

# --- Required ---
# Your Hedera account that receives the per-request HBAR payments (on the
# HEDERA_NETWORK above).
SELLER_ACCOUNT_ID=0.0.123456

# Anthropic API key for the vibecode AI. The server returns 502 (after payment)
# if this is missing — set it before going live.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-5-20250929)
ANTHROPIC_MODEL=

# --- Buyer demo (live mode only; NOT needed for --dry-run) ---
# Buyer Hedera account (on the HEDERA_NETWORK above) + ECDSA (secp256k1)
# private key. ED25519 keys do NOT work with the x402 tooling.
BUYER_ACCOUNT_ID=0.0.654321
BUYER_PRIVATE_KEY=
# Rail selection is a CLI flag on the demo: `--rail usdc` (default hbar).
# For a live USDC payment the buyer account must be associated with the
# USDC token of the configured network (0.0.429274 on testnet, 0.0.456858 on
# mainnet) and hold a balance.

# --- Optional ---
# Port the server listens on (default 3000)
PORT=3000
# Public base URL of this server, used as the x402 resource URL in the 402.
# Default: http://localhost:PORT
PUBLIC_URL=
# --- Pricing (USD-quoted, multi-asset) ---
# Price per request in USD cents (default 1 ~= $0.01). Both rails charge the
# same dollar price:
#   USDC rail: settles 1:1 in token base units (1¢ = 10,000 base units, 6 decimals)
#   HBAR rail: converts to tinybars at HBAR_USD_PRICE, rounding UP so the
#              seller is never shorted.
PRICE_USD_CENTS=1
# Server-configured HBAR/USD rate used for the HBAR-rail conversion.
# Default 0.20, so 1¢ = 5,000,000 tinybars (0.05 HBAR). Change as the market
# moves; the server rounds UP to whole tinybars on every conversion.
HBAR_USD_PRICE=0.20
# Base URL of the server for the buyer demo (default http://localhost:3000)
VIBECODE_URL=http://localhost:3000

# --- HCS audit feed (optional; audit logging is skipped if unset) ---
# Topic id from `npm run audit:init` (create it on the HEDERA_NETWORK above)
HCS_TOPIC_ID=0.0.789012
# Operator credentials used ONLY to submit audit messages
AUDIT_OPERATOR_ID=0.0.123456
AUDIT_OPERATOR_KEY=

# --- Platform economics: 98/2 split (optional; skipped if TREASURY unset) ---
# Voicescape treasury account (on the HEDERA_NETWORK above) receiving 2% of
# every payment, forwarded on-chain by the operator after each x402
# settlement.
TREASURY_ACCOUNT_ID=0.0.345678
# Private key for SELLER_ACCOUNT_ID — used ONLY to forward the 2% treasury
# share. HOT SERVER KEY: keep the operator account lean (sweep forwarded
# funds to cold storage regularly) so a server compromise can't drain much.
SELLER_PRIVATE_KEY=
